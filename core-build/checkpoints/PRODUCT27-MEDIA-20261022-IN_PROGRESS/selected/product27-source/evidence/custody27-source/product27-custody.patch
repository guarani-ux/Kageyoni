+        _fail('proc_nspid_parse_error')
+    chain = [int(x) for x in chain]
+    if chain[0] != proc_pid:
+        _fail('proc_pid_mapping_mismatch')
+    if not values['State'] or values['State'].split()[0] != fields[0]:
+        _fail('proc_state_disagreement')
