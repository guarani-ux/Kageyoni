{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kageyoni:will_attempt:0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "will-contract/0.1"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "technique": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "input_snapshot_hash": {
      "type": "string",
      "minLength": 1
    },
    "permission_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "rule",
              "judgment"
            ]
          },
          "rule": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "id",
                  "version"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "missing_policy": {
            "enum": [
              "block",
              "request_judgment"
            ]
          }
        },
        "required": [
          "id",
          "mode",
          "rule",
          "statement",
          "missing_policy"
        ]
      }
    },
    "contest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contested_change": {
          "type": "string",
          "minLength": 1
        },
        "opposing_effects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "id",
              "version"
            ]
          }
        },
        "relationship": {
          "enum": [
            "none",
            "coexists",
            "opposes",
            "interrupts",
            "transforms",
            "unknown"
          ]
        }
      },
      "required": [
        "contested_change",
        "opposing_effects",
        "relationship"
      ]
    },
    "resolution_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "randomness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "none",
            "d20"
          ]
        },
        "roll_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "difficulty": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "modifier": {
          "type": "integer"
        }
      },
      "required": [
        "mode",
        "roll_id",
        "difficulty",
        "modifier"
      ]
    },
    "outcome_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "outcome": {
            "enum": [
              "success",
              "partial",
              "failure",
              "interrupted"
            ]
          },
          "effect_indexes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "cost_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "outcome",
          "effect_indexes",
          "cost_ids"
        ]
      }
    },
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "assertion": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "confirmed",
                    "reported",
                    "inferred",
                    "contested",
                    "unknown",
                    "proposed"
                  ]
                }
              },
              "required": [
                "source",
                "assertion",
                "status"
              ]
            }
          }
        },
        "required": [
          "id",
          "actor",
          "scope",
          "decision",
          "basis"
        ]
      }
    }
  },
  "required": [
    "contract_version",
    "branch",
    "expected_revision",
    "request_id",
    "attempt_id",
    "actor",
    "expression",
    "technique",
    "intent",
    "targets",
    "input_snapshot_hash",
    "permission_checks",
    "contest",
    "resolution_policy",
    "randomness",
    "outcome_bindings",
    "judgments"
  ]
}
