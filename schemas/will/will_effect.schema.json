{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kageyoni:will_effect:0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "will-contract/0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "design_status": {
      "enum": [
        "proposed",
        "accepted"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "assertion": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "confirmed",
              "reported",
              "inferred",
              "contested",
              "unknown",
              "proposed"
            ]
          }
        },
        "required": [
          "source",
          "assertion",
          "status"
        ]
      }
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "technique": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "source_event": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "phase": {
      "enum": [
        "active",
        "suspended",
        "ended"
      ]
    },
    "anchor_records": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "start_clock": {
      "type": "string",
      "minLength": 1
    },
    "start_tick": {
      "type": "number"
    },
    "end_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "rule",
              "judgment"
            ]
          },
          "rule": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "id",
                  "version"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "missing_policy": {
            "enum": [
              "block",
              "request_judgment"
            ]
          }
        },
        "required": [
          "id",
          "mode",
          "rule",
          "statement",
          "missing_policy"
        ]
      }
    },
    "process_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "consequence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "residue_records": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "design_status",
    "evidence",
    "expression",
    "technique",
    "source_event",
    "targets",
    "phase",
    "anchor_records",
    "start_clock",
    "start_tick",
    "end_conditions",
    "process_ids",
    "consequence_ids",
    "residue_records"
  ]
}
